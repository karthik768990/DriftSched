# Everything in the project is tracked (code, data, results, docs, tests) EXCEPT the items below:
# installed dependencies, virtual environments, caches, build output, secrets and OS/editor files.

# Dependencies and virtual environments
node_modules/
/.venv/
/venv/
/env/
.env
.env.*

# Python caches and build output
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
